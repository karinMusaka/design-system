{
  "name": "design-system-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root — Dark × Neon × Sharp × Industrial design space",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:tokens": "pnpm --filter @karinMusaka/tokens build",
    "build:components": "pnpm --filter @karinMusaka/components build",
    "storybook": "pnpm --filter storybook dev",
    "clean": "pnpm -r exec rm -rf build dist"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.0"
}
